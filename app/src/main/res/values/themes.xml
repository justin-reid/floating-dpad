<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose supplies its own colours; the platform theme only has to keep the window
      chrome sane and follow the system light/dark setting, which DeviceDefault does.
    -->
    <style name="Theme.FloatingDpad" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>
</resources>
